              <div className="flex items-center gap-2.5">
                <span className="font-mono text-xs text-amber uppercase tracking-widest">
                  {new Date().toLocaleDateString("es-ES", {
                    weekday: "long",
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </span>
                <span className="font-mono text-[10px] text-muted-foreground/70">
                  · Cuaderno de supervivencia
                </span>
              </div>

              <div className="flex items-center gap-2">
                {storedPin ? (
                  <button
                    type="button"
                    onClick={() => setUnlockedForSession(!unlockedForSession)}
                    className="flex items-center gap-1.5 font-mono text-[11px] text-muted-foreground hover:text-amber border border-border/60 bg-panel-deep/50 px-2 py-0.5 rounded cursor-pointer"
                  >
                    {unlockedForSession ? (
                      <>
                        <Unlock className="h-3 w-3 text-patina" /> Desbloqueado
                      </>
                    ) : (
                      <>
                        <Lock className="h-3 w-3 text-amber" /> PIN Activo
                      </>
                    )}
                  </button>
                ) : (
                  <button
                    type="button"
                    onClick={() => setShowPinSetupModal(true)}
                    className="flex items-center gap-1.5 font-mono text-[11px] text-muted-foreground hover:text-brass border border-dashed border-border/60 px-2 py-0.5 rounded cursor-pointer"
                  >
                    <KeyRound className="h-3 w-3" /> Configurar PIN de sellado
                  </button>
                )}
              </div>
            </div>

            {/* CONTENIDO SEGÚN LA PESTAÑA ACTIVA */}
            <div className="pl-5 sm:pl-8 pt-5 flex-1 flex flex-col">
              {/* ─── PESTAÑA: HOY ─── */}
              {activeTab === "hoy" && (
                <div className="space-y-6">
                  {/* Si ya hay entradas hoy */}
                  {todayEntries.length > 0 && (
                    <div className="space-y-4">
                      <div className="flex items-center justify-between">
                        <p className="font-mono text-xs uppercase tracking-widest text-[#a89679]">
                          Entradas de la jornada presente:
                        </p>
                        <div className="flex gap-2">
                          {!hasMorningToday && (
                            <button
                              type="button"
                              onClick={() => handleOpenWriter("manana")}
                              className="font-mono text-[11px] text-amber hover:underline flex items-center gap-1 cursor-pointer"
                            >
                              <Sun className="h-3 w-3" /> Añadir matutina
                            </button>
                          )}
                          {!hasEveningToday && (
                            <button
                              type="button"
                              onClick={() => handleOpenWriter("noche")}
                              className="font-mono text-[11px] text-patina hover:underline flex items-center gap-1 cursor-pointer"
                            >
                              <Moon className="h-3 w-3" /> Añadir nocturna
                            </button>
                          )}
                          <button
                            type="button"
                            onClick={() => handleOpenWriter("libre")}
                            className="font-mono text-[11px] text-muted-foreground hover:text-foreground hover:underline flex items-center gap-1 cursor-pointer"
                          >
                            <Feather className="h-3 w-3" /> Nueva nota libre
                          </button>
                        </div>
                      </div>

                      <div className="space-y-4">
                        {todayEntries.map((entry) => (
                          <JournalCard
                            key={entry.id}
                            entry={entry}
                            isUnlocked={unlockedForSession}
                            onUnlockRequest={() => setShowPinSetupModal(true)}
                            onDelete={() => handleDelete(entry.id)}
                          />
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Si no hay entradas hoy, guiar al usuario con prompts opcionales */}
                  {todayEntries.length === 0 && (
                    <div className="py-4 space-y-6">
                      <div className="text-center max-w-md mx-auto py-2">
                        <p className="font-display text-xl uppercase tracking-wider text-amber">
                          Página en Blanco · Jornada sin registrar
                        </p>
                        <p className="font-mono text-xs text-muted-foreground mt-1">
                          Un cazador sin registro mental repite los mismos errores. Elige un punto de partida para anotar hoy:
                        </p>
                      </div>

                      <div className="grid gap-4 sm:grid-cols-2">
                        {/* Prompt Matutino */}
                        <div
                          onClick={() => handleOpenWriter("manana")}
                          className="group border border-[#42392c] bg-[#1e1a15]/80 hover:bg-[#252019] hover:border-amber p-4 cursor-pointer transition-all flex flex-col justify-between"
                        >
                          <div>
                            <div className="flex items-center justify-between">
                              <span className="font-mono text-[11px] uppercase tracking-widest text-amber flex items-center gap-1.5">
                                <Sun className="h-3.5 w-3.5 text-amber" /> Mañana
                              </span>
                              <span className="font-mono text-[10px] text-patina border border-patina/30 bg-patina/10 px-1.5 py-0.2">
                                +30 XP Disciplina
                              </span>
                            </div>
                            <p className="font-display text-lg text-foreground mt-2 group-hover:text-amber transition-colors">
                              ¿Qué esperas del día de hoy, cazador?
                            </p>
                            <p className="font-handwriting text-xl text-[#d4c6a9] mt-2 leading-relaxed">
                              "Declara tu intención de combate antes de que empiece el desgaste de la jornada..."
                            </p>
                          </div>
                          <div className="mt-4 pt-3 border-t border-[#352d22] flex items-center justify-between text-muted-foreground group-hover:text-amber font-mono text-xs">
                            <span>Escribir reflexión matutina</span>
                            <ChevronRight className="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" />
                          </div>
                        </div>

                        {/* Prompt Nocturno */}
                        <div
                          onClick={() => handleOpenWriter("noche")}
                          className="group border border-[#42392c] bg-[#1e1a15]/80 hover:bg-[#252019] hover:border-patina p-4 cursor-pointer transition-all flex flex-col justify-between"
                        >
                          <div>
                            <div className="flex items-center justify-between">
                              <span className="font-mono text-[11px] uppercase tracking-widest text-patina flex items-center gap-1.5">
                                <Moon className="h-3.5 w-3.5 text-patina" /> Noche
                              </span>
                              <span className="font-mono text-[10px] text-patina border border-patina/30 bg-patina/10 px-1.5 py-0.2">
                                +30 XP Disciplina
                              </span>
                            </div>
                            <p className="font-display text-lg text-foreground mt-2 group-hover:text-patina transition-colors">
                              ¿Qué contrato personal cerraste hoy?
                            </p>
                            <p className="font-handwriting text-xl text-[#d4c6a9] mt-2 leading-relaxed">
                              "Aunque no esté en el sistema, registra qué victoria o lección te llevas al campamento..."
                            </p>
                          </div>
                          <div className="mt-4 pt-3 border-t border-[#352d22] flex items-center justify-between text-muted-foreground group-hover:text-patina font-mono text-xs">
                            <span>Escribir cierre nocturno</span>
                            <ChevronRight className="h-3.5 w-3.5 group-hover:translate-x-1 transition-transform" />
                          </div>
                        </div>
                      </div>

                      {/* Botón para página libre */}
                      <div className="text-center pt-2">
                        <button
                          type="button"
                          onClick={() => handleOpenWriter("libre")}
                          className="inline-flex items-center gap-2 border border-dashed border-[#4d4233] px-4 py-2 font-mono text-xs uppercase tracking-wider text-[#d4c6a9] hover:border-amber hover:text-amber transition-colors cursor-pointer"
                        >
                          <Feather className="h-3.5 w-3.5" /> O abre una página libre sin preguntas
                        </button>
                      </div>
                    </div>
                  )}
                </div>
              )}

              {/* ─── PESTAÑA: ESCRITOR (MAÑANA / NOCHE O LIBRE) ─── */}
              {(activeTab === "manana_noche" || activeTab === "libre") && (
                <form onSubmit={handleSaveEntry} className="flex flex-col flex-1 space-y-4">
                  {/* Selector o indicador de Prompt */}
                  <div className="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-[#352d22]">
                    <div className="flex items-center gap-2">
                      {writingPromptType === "manana" && (
                        <>
                          <Sun className="h-4 w-4 text-amber" />
                          <span className="font-mono text-xs uppercase tracking-wider text-amber font-semibold">
                            Reflexión Matutina: ¿Qué esperas del día de hoy, cazador?
                          </span>
                        </>
                      )}
                      {writingPromptType === "noche" && (
                        <>
                          <Moon className="h-4 w-4 text-patina" />
                          <span className="font-mono text-xs uppercase tracking-wider text-patina font-semibold">
                            Cierre Nocturno: ¿Qué contrato personal cerraste hoy?
                          </span>
                        </>
                      )}
                      {writingPromptType === "libre" && (
                        <>
                          <Feather className="h-4 w-4 text-[#d4c6a9]" />
                          <span className="font-mono text-xs uppercase tracking-wider text-[#d4c6a9] font-semibold">
                            Página Libre · Pensamiento Abierto
                          </span>
                        </>
                      )}
                    </div>

                    <div className="flex items-center gap-1.5">
                      <button
                        type="button"
                        onClick={() => setWritingPromptType("manana")}
                        className={cn(
                          "px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider border cursor-pointer",
                          writingPromptType === "manana"
                            ? "border-amber bg-amber/20 text-amber font-semibold"
                            : "border-border/50 text-muted-foreground"
                        )}
                      >
                        Mañana
                      </button>
                      <button
                        type="button"
                        onClick={() => setWritingPromptType("noche")}
                        className={cn(
                          "px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider border cursor-pointer",
                          writingPromptType === "noche"
                            ? "border-patina bg-patina/20 text-patina font-semibold"
                            : "border-border/50 text-muted-foreground"
                        )}
                      >
                        Noche
                      </button>
                      <button
                        type="button"
                        onClick={() => setWritingPromptType("libre")}
                        className={cn(
                          "px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider border cursor-pointer",
                          writingPromptType === "libre"
                            ? "border-[#d4c6a9] bg-[#d4c6a9]/20 text-[#d4c6a9] font-semibold"
                            : "border-border/50 text-muted-foreground"
                        )}
                      >
                        Libre
                      </button>
                    </div>
                  </div>

                  {/* Área de texto manuscrita con renglones simulados */}
                  <div className="relative flex-1 min-h-[260px] notebook-ruled">
                    <textarea
                      value={contentInput}
                      onChange={(e) => setContentInput(e.target.value)}
                      placeholder={
                        writingPromptType === "manana"
                          ? "Escribe tus intenciones, enfoque o advertencias para la jornada..."
                          : writingPromptType === "noche"
                            ? "Anota lo que aprendiste, qué venciste hoy o qué dejas ir..."
                            : "Escribe libremente lo que tengas en mente..."
                      }
                      className="w-full h-full min-h-[260px] bg-transparent border-0 outline-none resize-none font-handwriting text-2xl sm:text-3xl text-[#f3eedd] leading-[32px] placeholder:text-[#6e6350]/60 placeholder:font-handwriting placeholder:text-2xl"
                      autoFocus
                    />
                  </div>

                  {/* Barra de opciones al pie de la página */}
                  <div className="pt-3 border-t border-[#352d22] flex flex-wrap items-center justify-between gap-3">
                    {/* Ánimo (mismo vocabulario que Cuerpo) */}
                    <div className="flex items-center gap-2">
                      <span className="font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
                        Ánimo:
                      </span>
                      <div className="flex flex-wrap gap-1">
                        {MOODS.map((m) => {
                          const isSel = selectedMood === m.key;
                          return (
                            <button
                              key={m.key}
                              type="button"
                              onClick={() => setSelectedMood(isSel ? "" : m.key)}
                              className={cn(
                                "border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider transition-colors cursor-pointer",
                                isSel
                                  ? "border-amber bg-amber/20 text-amber font-semibold"
                                  : "border-border/60 bg-panel-deep/50 text-muted-foreground hover:border-border hover:text-foreground"
                              )}
                            >
                              {m.label}
                            </button>
                          );
                        })}
                      </div>
                    </div>

                    {/* Toggle de Página Sellada y botón Guardar */}
                    <div className="flex items-center gap-3 ml-auto">
                      <label className="flex items-center gap-1.5 cursor-pointer select-none">
                        <input
                          type="checkbox"
                          checked={isSealedToggle}
                          onChange={(e) => {
                            if (e.target.checked && !storedPin) {
                              setShowPinSetupModal(true);
                            }
                            setIsSealedToggle(e.target.checked);
                          }}
                          className="accent-amber"
                        />
                        <span className="font-mono text-xs text-muted-foreground flex items-center gap-1">
                          <Lock className="h-3 w-3 text-amber" />
                          Sellar página (ocultar con PIN)
                        </span>
                      </label>

                      <button
                        type="submit"
                        disabled={savingEntry || !contentInput.trim()}
                        className="flex items-center gap-1.5 border border-amber bg-amber/20 px-4 py-1.5 font-mono text-xs uppercase tracking-wider text-amber hover:bg-amber/30 disabled:opacity-40 transition-colors cursor-pointer shadow-sm"
                      >
                        <Feather className="h-3.5 w-3.5" />
                        {savingEntry ? "Sellando..." : "Sellar en Bitácora (+30 XP)"}
                      </button>
                    </div>
                  </div>
                </form>
              )}

              {/* ─── PESTAÑA: ARCHIVO DE PÁGINAS ─── */}
              {activeTab === "archivo" && (
                <div className="space-y-4 flex-1">
                  <div className="flex items-center justify-between pb-2 border-b border-[#352d22]">
                    <p className="font-mono text-xs uppercase tracking-widest text-[#a89679]">
                      Hojas archivadas del expediente ({journalEntries.length})
                    </p>
                    <span className="font-mono text-[10px] text-muted-foreground">
                      Cronología completa
                    </span>
                  </div>

                  {journalEntries.length === 0 ? (
                    <div className="text-center py-16">
                      <p className="font-display text-lg text-muted-foreground uppercase">
                        El archivo está vacío
                      </p>
                      <p className="font-mono text-xs text-muted-foreground/60 mt-1">
                        Las páginas que redactes y selles quedarán resguardadas aquí.
                      </p>
                      <button
                        type="button"
                        onClick={() => handleOpenWriter("manana")}
                        className="mt-4 border border-amber/50 bg-amber/10 px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-amber hover:bg-amber/20 cursor-pointer"
                      >
                        Escribir primera página
                      </button>
                    </div>
                  ) : (
                    <div className="grid gap-3 sm:grid-cols-2">
                      {journalEntries.map((entry) => (
                        <div
                          key={entry.id}
                          className="border border-[#3d3428] bg-[#1d1914] p-3 hover:border-amber/60 transition-colors flex flex-col justify-between"
                        >
                          <div>
                            <div className="flex items-center justify-between text-xs font-mono text-muted-foreground">
                              <span className="flex items-center gap-1">
                                <Calendar className="h-3 w-3 text-amber" />
                                {entry.entry_date}
                              </span>
                              <span className="capitalize text-patina">
                                {entry.prompt_type}
                              </span>
                            </div>

                            {entry.is_sealed && !unlockedForSession ? (
                              <div className="my-3 py-2 px-3 border border-dashed border-amber/30 bg-amber/5 text-center">
                                <Lock className="h-4 w-4 text-amber mx-auto mb-1" />
                                <p className="font-mono text-[11px] text-amber uppercase">
                                  Página sellada
                                </p>
                                <p className="font-mono text-[9px] text-muted-foreground mt-0.5">
                                  Requiere desbloqueo local
                                </p>
                              </div>
                            ) : (
                              <p className="font-handwriting text-xl text-[#f3eedd] my-2 line-clamp-3 leading-snug">
                                "{entry.content}"
                              </p>
                            )}

                            {entry.mood && (
                              <p className="font-mono text-[10px] text-[#b3a186] mt-1">
                                Ánimo: <span className="capitalize font-semibold">{entry.mood}</span>
                              </p>
                            )}
                          </div>

                          <div className="pt-2 mt-2 border-t border-[#312a20] flex items-center justify-between font-mono text-[10px]">
                            {entry.is_sealed && (
                              <span className="text-amber flex items-center gap-1">
                                <Lock className="h-2.5 w-2.5" /> Sellada
                              </span>
                            )}
                            <button
                              type="button"
                              onClick={() => handleDelete(entry.id)}
                              className="text-rust/80 hover:text-rust flex items-center gap-1 ml-auto cursor-pointer"
                            >
                              <Trash2 className="h-3 w-3" /> Arrancar hoja
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* ─── MODAL: CONFIGURAR / DESBLOQUEAR PIN LOCAL ─── */}
      {showPinSetupModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-4">
          <div className="w-full max-w-sm border border-amber/60 bg-[#191612] p-5 shadow-2xl">
            <div className="flex items-center gap-2 text-amber font-display text-lg uppercase tracking-wider pb-2 border-b border-border/60">
              <Lock className="h-5 w-5" />
              {storedPin ? "Desbloquear Páginas Selladas" : "Configurar PIN de Sellado"}
            </div>

            {storedPin ? (
              /* Desbloquear con PIN existente */
              <form onSubmit={handleUnlockWithPin} className="space-y-4 pt-4">
                <p className="font-mono text-xs text-muted-foreground">
                  Ingresa tu PIN de 4 dígitos para revelar las páginas selladas en este dispositivo.
                </p>
                <div>
                  <input
                    type="password"
                    maxLength={4}
                    value={enteredPin}
                    onChange={(e) => setEnteredPin(e.target.value)}
                    placeholder="****"
                    className="w-full border border-border bg-panel-deep p-2 text-center font-mono text-xl tracking-[0.4em] text-amber outline-none focus:border-amber"
                    autoFocus
                  />
                </div>

                <div className="border border-amber/30 bg-amber/5 p-2 rounded text-[10px] font-mono text-amber/80 flex items-start gap-1.5">
                  <ShieldAlert className="h-3.5 w-3.5 shrink-0 mt-0.5" />
                  <span>
                    Oculta en este dispositivo. No es cifrado de grado militar; tus datos están protegidos por tu cuenta y RLS en Supabase.
                  </span>
                </div>

                <div className="flex justify-end gap-2 pt-2">
                  <button
                    type="button"
                    onClick={() => setShowPinSetupModal(false)}
                    className="border border-border px-3 py-1 font-mono text-xs text-muted-foreground hover:text-foreground cursor-pointer"
                  >
                    Cancelar
                  </button>
                  <button
                    type="submit"
                    className="border border-amber bg-amber/20 px-3 py-1 font-mono text-xs text-amber hover:bg-amber/30 uppercase cursor-pointer"
                  >
                    Desbloquear
                  </button>
                </div>
              </form>
            ) : (
              /* Crear nuevo PIN */
              <form onSubmit={handleSetPin} className="space-y-4 pt-4">
                <p className="font-mono text-xs text-muted-foreground">
                  Crea un PIN numérico de 4 dígitos. Se guardará únicamente en este dispositivo en localStorage para ocultar tus notas reservadas.
                </p>
                <div>
                  <input
                    type="password"
                    maxLength={4}
                    value={newPinInput}
                    onChange={(e) => setNewPinInput(e.target.value.replace(/\D/g, ""))}
                    placeholder="ej. 1234"
                    className="w-full border border-border bg-panel-deep p-2 text-center font-mono text-xl tracking-[0.4em] text-amber outline-none focus:border-amber"
                    autoFocus
                  />
                </div>

                <div className="border border-amber/30 bg-amber/5 p-2 rounded text-[10px] font-mono text-amber/80 flex items-start gap-1.5">
                  <ShieldAlert className="h-3.5 w-3.5 shrink-0 mt-0.5" />
                  <span>
                    Honestidad de terminal: Esta función oculta la pantalla frente a miradas indiscretas en este navegador, no es cifrado criptográfico.
                  </span>
                </div>

                <div className="flex justify-end gap-2 pt-2">
                  <button
                    type="button"
                    onClick={() => setShowPinSetupModal(false)}
                    className="border border-border px-3 py-1 font-mono text-xs text-muted-foreground hover:text-foreground cursor-pointer"
                  >
                    Cancelar
                  </button>
                  <button
                    type="submit"
                    className="border border-amber bg-amber/20 px-3 py-1 font-mono text-xs text-amber hover:bg-amber/30 uppercase cursor-pointer"
                  >
                    Establecer PIN
                  </button>
                </div>
              </form>
            )}
          </div>
        </div>
      )}
    </Shell>
  );
}

// Subcomponente de Tarjeta de Entrada
function JournalCard({
  entry,
  isUnlocked,
  onUnlockRequest,
  onDelete,
}: {
  entry: JournalEntry;
  isUnlocked: boolean;
  onUnlockRequest: () => void;
  onDelete: () => void;
}) {
  const isLocked = entry.is_sealed && !isUnlocked;

  return (
    <div className="border border-[#383025] bg-[#1d1914]/90 p-4 relative shadow-sm hover:border-[#4d4233] transition-colors">
      {/* Cabecera de la entrada */}
      <div className="flex flex-wrap items-center justify-between gap-2 pb-2 border-b border-[#31291e]">
        <div className="flex items-center gap-2">
          {entry.prompt_type === "manana" && <Sun className="h-3.5 w-3.5 text-amber" />}
          {entry.prompt_type === "noche" && <Moon className="h-3.5 w-3.5 text-patina" />}
          {entry.prompt_type === "libre" && <Feather className="h-3.5 w-3.5 text-[#d4c6a9]" />}
          <span className="font-mono text-xs uppercase tracking-wider text-[#b8a68b] font-semibold">
            {entry.prompt_type === "manana"
              ? "Reflexión Matutina"
              : entry.prompt_type === "noche"
                ? "Cierre Nocturno"
                : "Nota Libre"}
          </span>
          {entry.mood && (
            <span className="font-mono text-[10px] text-brass/80 border border-brass/30 bg-brass/10 px-1.5 py-0.2 capitalize">
              {entry.mood}
            </span>
          )}
        </div>

        <div className="flex items-center gap-2">
          {entry.is_sealed && (
            <span className="inline-flex items-center gap-1 font-mono text-[10px] text-amber border border-amber/40 bg-amber/10 px-1.5 py-0.2 uppercase">
              <Lock className="h-2.5 w-2.5" /> Sellada
            </span>
          )}
          <button
            type="button"
            onClick={onDelete}
            title="Arrancar hoja"
            className="text-muted-foreground/60 hover:text-rust transition-colors cursor-pointer"
          >
            <Trash2 className="h-3.5 w-3.5" />
          </button>
        </div>
      </div>

      {/* Contenido */}
      <div className="pt-3 pb-1">
        {isLocked ? (
          <div className="py-6 px-4 text-center border border-dashed border-amber/30 bg-amber/5 rounded">
            <Lock className="h-6 w-6 text-amber mx-auto mb-2" />
            <p className="font-display text-base text-amber uppercase tracking-wider">
              Página sellada
            </p>
            <p className="font-mono text-xs text-muted-foreground mt-1 max-w-sm mx-auto">
              Contenido oculto en este dispositivo. No es una entrada cifrada.
            </p>
            <button
              type="button"
              onClick={onUnlockRequest}
              className="mt-3 inline-flex items-center gap-1.5 border border-amber/60 bg-amber/15 px-3 py-1 font-mono text-xs text-amber uppercase hover:bg-amber/25 cursor-pointer"
            >
              <KeyRound className="h-3 w-3" /> Ingresar PIN para ver
            </button>
          </div>
        ) : (
          <p className="font-handwriting text-2xl sm:text-3xl text-[#f3eedd] leading-relaxed whitespace-pre-wrap">
            {entry.content}
          </p>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/routes/cuerpo.tsx">
import { createFileRoute } from "@tanstack/react-router";
import { useMemo, useState } from "react";
import { Bar, BarChart, CartesianGrid, Line, LineChart, XAxis, YAxis } from "recharts";
import { Shell } from "@/components/quarry/shell";
import { Panel, StatBar, Tag } from "@/components/quarry/panel";
import { ContractRow } from "@/components/quarry/contract-row";
import {
  NewWorkoutModal,
  NewPersonalRecordModal,
  UpdatePersonalRecordModal,
} from "@/components/quarry/body-dialogs";
import {
  Activity,
  Dumbbell,
  Ruler,
  Timer,
  Trophy,
  Plus,
  Scale,
  BatteryWarning,
  BatteryLow,
  BatteryMedium,
  Battery,
  BatteryCharging,
  Moon,
  Edit3,
  CheckCircle2,
  Zap,
} from "lucide-react";
import { toast } from "sonner";
import {
  ChartContainer,
  ChartTooltip,
  ChartTooltipContent,
  type ChartConfig,
} from "@/components/ui/chart";
import { useQuarry } from "@/lib/state/quarry";
import { cn } from "@/lib/utils";
import type { PersonalRecord } from "@/lib/data/types";

const ENERGY_OPTIONS = [
  { level: 1, label: "Agotado", pct: 20, icon: BatteryWarning, color: "text-rust border-rust/40 hover:border-rust" },
  { level: 2, label: "Desgastado", pct: 40, icon: BatteryLow, color: "text-amber/70 border-amber/30 hover:border-amber" },
  { level: 3, label: "Estable", pct: 60, icon: BatteryMedium, color: "text-amber border-amber/40 hover:border-amber" },
  { level: 4, label: "Firme", pct: 80, icon: Battery, color: "text-patina/80 border-patina/40 hover:border-patina" },
  { level: 5, label: "A tope", pct: 100, icon: BatteryCharging, color: "text-patina border-patina hover:border-patina" },
];

const MOOD_OPTIONS = [
  "combativo",
  "enfocado",
  "neutro",
  "fatigado",
  "sobrecargado",
];

export const Route = createFileRoute("/cuerpo")({
  head: () => ({
    meta: [
      { title: "Sector del Cuerpo · QUARRY" },
      {
        name: "description",
        content:
          "Masa corporal, medidas, récords personales, volumen de entrenamiento y contratos físicos del cazador en la terminal QUARRY.",
      },
      { property: "og:title", content: "Sector del Cuerpo · QUARRY" },
      {
        property: "og:description",
        content:
          "Bitácora de entrenamientos y mantenimiento del chasis biológico del cazador.",
      },
    ],
  }),
  component: CuerpoPage,
});

const weightConfig = {
  peso: { label: "Masa corporal", color: "var(--amber)" },
} satisfies ChartConfig;

const volumeConfig = {
  minutos: { label: "Minutos", color: "var(--patina)" },
} satisfies ChartConfig;

function weekKey(d: Date) {
  const x = new Date(d);
  x.setHours(0, 0, 0, 0);
  x.setDate(x.getDate() - ((x.getDay() + 6) % 7));
  return x;
}

function CuerpoPage() {
  const { state, completeContract, isLoading, addBodyStat, submitDailyCheckin } = useQuarry();
  const [flash, setFlash] = useState<string | null>(null);
  const [showWorkoutModal, setShowWorkoutModal] = useState(false);
  const [showRecordModal, setShowRecordModal] = useState(false);
  const [selectedRecordToUpdate, setSelectedRecordToUpdate] = useState<PersonalRecord | null>(null);
  const [weightInput, setWeightInput] = useState("");
  const [savingWeight, setSavingWeight] = useState(false);

  // Check-in diario de energía y disposición
  const [isEditingCheckin, setIsEditingCheckin] = useState(false);
  const [selectedEnergy, setSelectedEnergy] = useState<number>(3);
  const [selectedMood, setSelectedMood] = useState<string>("");
  const [sleepHoursInput, setSleepHoursInput] = useState<string>("");
  const [savingCheckin, setSavingCheckin] = useState(false);

  function handleStartEditingCheckin() {
    if (state?.today_checkin) {
      setSelectedEnergy(state.today_checkin.energy_level);
      setSelectedMood(state.today_checkin.mood || "");
      setSleepHoursInput(state.today_checkin.sleep_hours != null ? String(state.today_checkin.sleep_hours) : "");
    }
    setIsEditingCheckin(true);
  }

  async function handleSaveCheckin() {
    setSavingCheckin(true);
    try {
      const res = await submitDailyCheckin({
        energy_level: selectedEnergy,
        mood: selectedMood || null,
        sleep_hours: sleepHoursInput ? parseFloat(sleepHoursInput) : null,
      });
      if (res) {
        toast.success(`Check-in diario registrado · Energía al ${selectedEnergy * 20}%`);
        setIsEditingCheckin(false);
      } else {
        toast.error("Error al registrar check-in");
      }
    } catch (err) {
      console.error(err);
      toast.error("Error al registrar check-in");
    } finally {
      setSavingCheckin(false);
    }
  }


  if (isLoading || !state || !state.profile) {
    return (
      <div className="flex min-h-screen items-center justify-center bg-background">
        <div className="text-center">
          <p className="font-display text-2xl text-amber">QUARRY</p>
          <p className="label-mono mt-2">Cargando expediente...</p>
        </div>
      </div>
    );
  }

  const weights = state.body_stats
    .filter((b) => b.metric === "peso")
    .slice()
    .sort((a, b) => +new Date(a.recorded_at) - +new Date(b.recorded_at));
  const measures = state.body_stats.filter((b) => b.metric === "medida");
  const records = state.body_stats.filter((b) => b.metric === "record_personal");

  const currentWeight = weights[weights.length - 1]?.value ?? 0;
  const firstWeight = weights[0]?.value ?? currentWeight;
  const weightDelta = currentWeight - firstWeight;

  const weightData = weights.map((w) => ({
    label: new Date(w.recorded_at).toLocaleDateString("es", {
      day: "2-digit",
      month: "short",
    }),
    peso: w.value,
  }));

  const weeks = useMemo(() => {
    const out: { key: number; label: string; minutos: number; sesiones: number }[] = [];
    for (let i = 5; i >= 0; i--) {
      const start = weekKey(new Date());
      start.setDate(start.getDate() - i * 7);
      out.push({
        key: +start,
        label: start.toLocaleDateString("es", { day: "2-digit", month: "short" }),
        minutos: 0,
        sesiones: 0,
      });
    }
    state.workouts.forEach((w) => {
      const k = +weekKey(new Date(w.date));
      const bucket = out.find((b) => b.key === k);
      if (bucket) {
        bucket.minutos += w.duration_minutes;
        bucket.sesiones += 1;
      }
    });
    return out;
  }, [state.workouts]);

  const thisWeek = weeks[weeks.length - 1];
  const lastWeek = weeks[weeks.length - 2];
  const avgMinutes = Math.round(weeks.reduce((a, w) => a + w.minutos, 0) / weeks.length);
  const volumeDelta = thisWeek.minutos - (lastWeek?.minutos ?? 0);

  // Tendencia semanal honesta de energía reportada (compara últimos 7 vs anteriores 7)
  const energyTrend = useMemo(() => {
    const checkins = state?.recent_checkins || [];
    if (checkins.length < 4) {
      return {
        status: "gathering",
        label: "Aún reuniendo datos",
        arrow: "·",
        color: "text-muted-foreground border-border/60 bg-panel-deep/50",
      };
    }
    const last7 = checkins.slice(0, 7);
    const prev7 = checkins.slice(7, 14);

    const avgLast7 = last7.reduce((sum, c) => sum + c.energy_level, 0) / last7.length;

    let diff = 0;
    if (prev7.length >= 2) {
      const avgPrev7 = prev7.reduce((sum, c) => sum + c.energy_level, 0) / prev7.length;
      diff = avgLast7 - avgPrev7;
    } else {
      const half = Math.floor(checkins.length / 2);
      const recentHalf = checkins.slice(0, half);
      const olderHalf = checkins.slice(half);
      const avgRecent = recentHalf.reduce((sum, c) => sum + c.energy_level, 0) / recentHalf.length;
      const avgOlder = olderHalf.reduce((sum, c) => sum + c.energy_level, 0) / olderHalf.length;
      diff = avgRecent - avgOlder;
    }

    if (diff > 0.25) {
      return {
        status: "up",
        label: "Energía al alza",
        arrow: "↑",
        color: "text-patina border-patina/40 bg-patina/10",
      };
    } else if (diff < -0.25) {
      return {
        status: "down",
        label: "Energía a la baja",
        arrow: "↓",
        color: "text-rust border-rust/40 bg-rust/10",
      };
    } else {
      return {
        status: "stable",
        label: "Energía estable",
        arrow: "→",
        color: "text-amber border-amber/40 bg-amber/10",
      };
    }
  }, [state?.recent_checkins]);

  const recent = state.workouts
    .slice()
    .sort((a, b) => +new Date(b.date) - +new Date(a.date))
    .slice(0, 8);

  const cuerpoSector = state.sectors.find(
    (s) => s.key === "cuerpo" || s.name.toLowerCase().includes("cuerpo"),
  );
  const sectorContracts = state.contracts.filter(
    (c) => c.sector_id === "sec_cuerpo" || (cuerpoSector && c.sector_id === cuerpoSector.id),
  );

  function handleComplete(id: string) {
    const c = state?.contracts.find((x) => x.id === id);
    completeContract(id);
    if (c) setFlash(`Contrato físico sellado · +${c.reward_xp} xp`);
    setTimeout(() => setFlash(null), 2200);
  }

  async function handleRegisterWeight(e: React.FormEvent) {
    e.preventDefault();
    const val = Number(weightInput);
    if (!val || val <= 0) {
      toast.error("Ingresa un peso válido");
      return;
    }
    setSavingWeight(true);
    try {
      const res = await addBodyStat({
        metric: "peso",
        label: "Masa corporal",
        value: val,
        unit: "kg",
        recorded_at: new Date().toISOString(),
      });
      if (res) {
        toast.success(`Peso de ${val.toFixed(1)} kg registrado en el expediente`);
        setWeightInput("");
      } else {
        toast.error("Error al persistir el peso");
      }
    } catch (err) {
      console.error(err);
      toast.error("Error al registrar peso");
    } finally {
      setSavingWeight(false);
    }
  }

  return (
    <Shell
      title="Sector del Cuerpo"
      subtitle={`${currentWeight.toFixed(1)} kg · ${thisWeek.sesiones} sesiones esta semana · ${thisWeek.minutos} min acumulados`}
    >
      {flash && (
        <div className="stamp-in mb-4 inline-block border border-patina px-3 py-1 font-mono text-[11px] tracking-[0.18em] text-patina uppercase">
          {flash}
        </div>
      )}

      {/* ─── PARTE A: CHECK-IN DIARIO DE ENERGÍA Y ESTADO REAL ─── */}
      <div className="mb-4 border border-border bg-panel/75 p-3.5 transition-all">
        {state.today_checkin && !isEditingCheckin ? (
          /* Modo Lectura */
          <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div className="flex items-center gap-3">
              {(() => {
                const opt =
                  ENERGY_OPTIONS.find((o) => o.level === state.today_checkin?.energy_level) ||
                  ENERGY_OPTIONS[2];
                const Icon = opt.icon;
                return (
                  <div className="flex h-11 w-11 shrink-0 items-center justify-center border border-border bg-panel-deep">
                    <Icon className={cn("h-6 w-6", opt.color.split(" ")[0])} />
                  </div>
                );
              })()}
              <div>
                <div className="flex items-center gap-2 flex-wrap">
                  <span className="font-display text-base tracking-wide text-foreground">
                    Check-in Diario Registrado
                  </span>
                  <span className="inline-flex items-center gap-1 border border-patina/40 bg-patina/10 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-patina">
                    <CheckCircle2 className="h-3 w-3" /> Hoy
                  </span>
                  <span className={cn("inline-flex items-center gap-1 border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider", energyTrend.color)}>
                    <span>{energyTrend.arrow}</span>
                    <span>{energyTrend.label}</span>
                  </span>
                </div>
                <div className="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted-foreground">
                  <span>
                    Energía:{" "}
                    <strong className="text-amber">
                      {state.today_checkin.energy_level * 20}%
                    </strong>{" "}
                    ({ENERGY_OPTIONS.find((o) => o.level === state.today_checkin?.energy_level)?.label})
                  </span>
                  {state.today_checkin.sleep_hours != null && (
                    <span>
                      · Sueño:{" "}
                      <strong className="text-foreground">
                        {state.today_checkin.sleep_hours} hrs
                      </strong>
                    </span>
                  )}
                  {state.today_checkin.mood && (
                    <span>
                      · Ánimo:{" "}
                      <strong className="text-brass capitalize">
                        {state.today_checkin.mood}
                      </strong>
                    </span>
                  )}
                </div>
              </div>
            </div>

            <button
              type="button"
              onClick={handleStartEditingCheckin}
              className="self-start sm:self-center flex items-center gap-1.5 border border-border bg-panel-deep/80 px-2.5 py-1.5 font-mono text-xs uppercase tracking-wider text-muted-foreground hover:border-amber hover:text-amber transition-colors"
            >
              <Edit3 className="h-3 w-3" /> Editar
            </button>
          </div>
        ) : (
          /* Modo Formulario / Selector rápido */
          <div className="space-y-3">
            <div className="flex items-center justify-between flex-wrap gap-2">
              <div>
                <div className="flex items-center gap-2 flex-wrap">
                  <p className="font-display text-base tracking-wider text-amber uppercase">
                    {isEditingCheckin ? "Actualizar Check-in Diario" : "Check-in Diario · Estado del Cazador"}
                  </p>
                  <span className={cn("inline-flex items-center gap-1 border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider", energyTrend.color)}>
                    <span>{energyTrend.arrow}</span>
                    <span>{energyTrend.label}</span>
                  </span>
                </div>
                <p className="font-mono text-xs text-muted-foreground mt-0.5">
                  Indica cómo llegó tu chasis biológico hoy para llevar un registro real de cómo te sientes cada día.
                </p>
              </div>
              {isEditingCheckin && (
                <button
                  type="button"
                  onClick={() => setIsEditingCheckin(false)}
                  className="font-mono text-xs text-muted-foreground hover:text-foreground underline underline-offset-4"
                >
                  Cancelar
                </button>
              )}
            </div>

            {/* Selector de 5 niveles de energía */}
            <div>
              <p className="label-mono mb-1.5">Nivel de energía operativa (1 a 5)</p>
              <div className="grid grid-cols-2 gap-2 sm:grid-cols-5">
                {ENERGY_OPTIONS.map((opt) => {
                  const Icon = opt.icon;
                  const isSelected = selectedEnergy === opt.level;
                  return (
                    <button
                      key={opt.level}
                      type="button"
                      onClick={() => setSelectedEnergy(opt.level)}
                      className={cn(
                        "flex flex-col items-center justify-center gap-1 border p-2.5 text-center transition-all cursor-pointer",
                        isSelected
                          ? "border-amber bg-amber/15 shadow-[0_0_12px_rgba(217,119,6,0.2)]"
                          : "border-border bg-panel-deep/60 hover:border-border/80 hover:bg-panel-deep"
                      )}
                    >
                      <Icon className={cn("h-5 w-5", isSelected ? "text-amber" : "text-muted-foreground")} />
                      <span className={cn("font-display text-sm uppercase tracking-wide", isSelected ? "text-amber font-semibold" : "text-foreground")}>
                        {opt.label}
                      </span>
                      <span className="font-mono text-[10px] text-muted-foreground">
                        {opt.pct}%
                      </span>
                    </button>
                  );
                })}
              </div>
            </div>

            {/* Fila secundaria: Sueño y Ánimo */}
            <div className="grid gap-3 sm:grid-cols-2 pt-1 border-t border-border/50">
              <div>
                <label className="label-mono flex items-center gap-1.5 mb-1">
                  <Moon className="h-3 w-3 text-patina" /> Horas de sueño (opcional)
                </label>
                <input
                  type="number"
                  step="0.5"
                  min="0"
                  max="24"
                  placeholder="ej. 7.5"
                  value={sleepHoursInput}
                  onChange={(e) => setSleepHoursInput(e.target.value)}
                  className="w-full border border-border bg-panel-deep/80 px-2.5 py-1 font-mono text-xs text-foreground outline-none focus:border-amber placeholder:text-muted-foreground/50"
                />
              </div>

              <div>
                <label className="label-mono mb-1 block">Estado anímico (opcional)</label>
                <div className="flex flex-wrap gap-1.5">
                  {MOOD_OPTIONS.map((m) => {
                    const isMoodSelected = selectedMood === m;
                    return (
                      <button
                        key={m}
                        type="button"
                        onClick={() => setSelectedMood(isMoodSelected ? "" : m)}
                        className={cn(
                          "border px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider transition-colors cursor-pointer",
                          isMoodSelected
                            ? "border-amber bg-amber/20 text-amber font-semibold"
                            : "border-border/70 bg-panel-deep/60 text-muted-foreground hover:border-border hover:text-foreground"
                        )}
                      >
                        {m}
                      </button>
                    );
                  })}
                </div>
              </div>
            </div>

            {/* Botón de guardado rápido */}
            <div className="pt-1 flex justify-end">
              <button
                type="button"
                onClick={() => handleSaveCheckin()}
                disabled={savingCheckin}
                className="flex items-center gap-1.5 border border-amber bg-amber/20 px-4 py-1.5 font-mono text-xs uppercase tracking-wider text-amber hover:bg-amber/30 disabled:opacity-50 transition-colors shadow-sm cursor-pointer"
              >
                <Zap className="h-3.5 w-3.5" />
                {savingCheckin ? "Guardando lectura..." : isEditingCheckin ? "Actualizar Check-in" : "Registrar Check-in de Hoy"}
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Barra de acciones rápidas */}
      <div className="mb-4 flex flex-wrap items-center gap-2">
        <form onSubmit={handleRegisterWeight} className="flex items-center gap-1.5 border border-border bg-panel-deep/80 p-1">
          <Scale className="ml-1.5 h-3.5 w-3.5 text-amber" />
          <input
            type="number"
            step="0.1"
            min="20"
            max="300"
            placeholder="Peso hoy (kg)"
            value={weightInput}
            onChange={(e) => setWeightInput(e.target.value)}
            className="w-28 bg-transparent px-1.5 font-mono text-xs text-foreground outline-none placeholder:text-muted-foreground/60"
          />
          <button
            type="submit"
            disabled={savingWeight || !weightInput}
            className="border border-amber bg-amber/15 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-amber hover:bg-amber/25 disabled:opacity-50 transition-colors"
          >
            {savingWeight ? "..." : "Sellar Peso"}
          </button>
        </form>

        <button
          onClick={() => setShowWorkoutModal(true)}
          className="flex items-center gap-1.5 border border-patina bg-patina/15 px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-patina hover:bg-patina/25 transition-colors"
        >
          <Plus className="h-3.5 w-3.5" /> Anotar Entrenamiento
        </button>

        <button
          onClick={() => setShowRecordModal(true)}
          className="flex items-center gap-1.5 border border-border bg-panel-deep/60 px-3 py-1.5 font-mono text-xs uppercase tracking-wider text-muted-foreground hover:border-brass hover:text-foreground transition-colors"
        >
          <Plus className="h-3.5 w-3.5" /> Declarar Récord
        </button>
      </div>

      <div className="grid items-start gap-4 xl:grid-cols-3">
        <Panel
          riveted
          title="Ficha de estado físico"
          meta="Chasis biológico · lectura del último registro"
          className="flicker-in xl:col-span-2"
        >
          <div className="grid gap-5 sm:grid-cols-2">
            <div>
              <p className="label-mono">Masa corporal</p>
              <p className="font-display mt-1 text-4xl tracking-[0.12em] text-amber">
                {currentWeight.toFixed(1)}
                <span className="ml-2 font-mono text-sm tracking-normal text-muted-foreground">
                  kg
                </span>
              </p>
              <p
                className={cn(
                  "mt-1.5 font-mono text-xs",
                  weightDelta <= 0 ? "text-patina" : "text-rust",
                )}
              >
                {weightDelta >= 0 ? "+" : ""}
                {weightDelta.toFixed(1)} kg en {weights.length} registros semanales
              </p>
              <div className="mt-4">
                {weightData.length >= 2 ? (
                  <ChartContainer config={weightConfig} className="h-[150px] w-full">
                    <LineChart data={weightData} margin={{ left: 0, right: 8, top: 8 }}>
                      <CartesianGrid
                        vertical={false}
                        stroke="var(--border)"
                        strokeDasharray="2 4"
                      />
                      <XAxis
                        dataKey="label"
                        tickLine={false}
                        axisLine={false}
                        interval="preserveStartEnd"
                        tick={{ fill: "var(--muted-foreground)", fontSize: 10 }}
                      />
                      <YAxis
                        width={34}
                        domain={["dataMin - 1", "dataMax + 1"]}
                        tickLine={false}
                        axisLine={false}
                        tick={{ fill: "var(--muted-foreground)", fontSize: 10 }}
                      />
                      <ChartTooltip content={<ChartTooltipContent />} />
                      <Line
                        type="monotone"
                        dataKey="peso"
                        stroke="var(--amber)"
                        strokeWidth={1.5}
                        dot={false}
                        isAnimationActive={false}
                      />
                    </LineChart>
                  </ChartContainer>
                ) : (
                  <div className="flex h-[150px] w-full items-center justify-center border border-dashed border-border/50 p-4 text-center font-mono text-xs text-muted-foreground">
                    {weightData.length === 1
                      ? `Un solo registro (${weightData[0].peso} kg). Se requieren al menos 2 marcas para trazar la curva.`
                      : "Sin registros de masa corporal. Registra tu peso para ver la tendencia."}
                  </div>
                )}
              </div>
            </div>

            <div>
              <p className="label-mono inline-flex items-center gap-1.5">
                <Ruler className="h-3.5 w-3.5" /> Medidas clave
              </p>
              <ul className="mt-2 grid grid-cols-2 gap-2">
                {measures.map((m) => (
                  <li key={m.id} className="border border-border bg-panel-deep/50 p-3">
                    <p className="label-mono truncate">{m.label}</p>
                    <p className="mt-1 font-mono text-lg text-foreground">
