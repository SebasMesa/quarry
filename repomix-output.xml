      {NAV.map((item) => {
        const active = pathname === item.to;
        const Icon = item.icon;
        if (!item.enabled) {
          return (
            <div
              key={item.key}
              className="flex items-center gap-2.5 border border-dashed border-border/60 px-2.5 py-2 opacity-55"
