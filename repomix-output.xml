@layer base {
  * {
    border-color: var(--color-border);
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: var(--font-display);
    letter-spacing: 0.08em;
    font-weight: 600;
  }
}

/* Scanlines CRT muy leves */
@utility scanlines {
  position: relative;

  &::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(to bottom,
        color-mix(in oklab, black 22%, transparent) 0px,
        color-mix(in oklab, black 22%, transparent) 1px,
        transparent 1px,
        transparent 3px);
    opacity: 0.28;
    z-index: 1;
  }
}

/* Viñeta en esquinas */
@utility vignette {
  &::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 100% at 50% 40%,
        transparent 45%,
        color-mix(in oklab, black 55%, transparent) 100%);
    z-index: 0;
  }
}

@utility panel-base {
  position: relative;
  background-color: var(--panel);
  border: 1px solid var(--border);
  overflow: hidden;
}

/* Remaches en esquinas */
@utility riveted {
  position: relative;

  &::before {
    content: "";
    position: absolute;
    inset: 6px;
    pointer-events: none;
    border-radius: 1px;
    background-image:
      radial-gradient(circle 2.5px at 0 0,
        color-mix(in oklab, var(--brass) 85%, transparent) 98%,
        transparent 100%),
      radial-gradient(circle 2.5px at 100% 0,
        color-mix(in oklab, var(--brass) 85%, transparent) 98%,
        transparent 100%),
      radial-gradient(circle 2.5px at 0 100%,
        color-mix(in oklab, var(--brass) 85%, transparent) 98%,
        transparent 100%),
      radial-gradient(circle 2.5px at 100% 100%,
        color-mix(in oklab, var(--brass) 85%, transparent) 98%,
        transparent 100%);
    background-repeat: no-repeat;
    z-index: 2;
  }
}

@utility label-mono {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  color: var(--muted-foreground);
}

@keyframes stamp-in {
  0% {
    transform: scale(1.6) rotate(-14deg);
    opacity: 0;
  }

  60% {
    transform: scale(0.94) rotate(-8deg);
    opacity: 1;
  }

  100% {
    transform: scale(1) rotate(-8deg);
    opacity: 1;
  }
}

@utility stamp-in {
  animation: stamp-in 320ms cubic-bezier(0.2, 0.9, 0.3, 1) both;
}

@keyframes flicker-in {
  0% {
    opacity: 0.1;
  }

  40% {
    opacity: 0.8;
  }

  55% {
    opacity: 0.3;
  }

  100% {
    opacity: 1;
  }
}

@utility flicker-in {
  animation: flicker-in 420ms steps(6, end) both;
}

@utility font-journal {
  font-family: var(--font-journal);
}

@utility font-handwriting {
  font-family: var(--font-journal);
}

.notebook-ruled {
  background-image: repeating-linear-gradient(
    transparent,
    transparent 35px,
    rgba(255, 255, 255, 0.04) 35px,
    rgba(255, 255, 255, 0.04) 36px
  );
  line-height: 36px;
}

@keyframes page-turn {
  0% {
    transform: perspective(1200px) rotateY(-8deg) scale(0.98);
    opacity: 0.5;
  }
  100% {
    transform: perspective(1200px) rotateY(0deg) scale(1);
    opacity: 1;
  }
}

@utility page-turn {
  animation: page-turn 320ms cubic-bezier(0.16, 1, 0.3, 1) both;
}
