      />
      <NewBudgetModal
        isOpen={showBudgetModal}
        onClose={() => setShowBudgetModal(false)}
      />
      <NewSavingsGoalModal
        isOpen={showGoalModal}
        onClose={() => setShowGoalModal(false)}
      />
      <ContributeGoalModal
        isOpen={!!contributeGoal}
        goal={contributeGoal}
        onClose={() => setContributeGoal(null)}
      />
    </Shell>
