            )}
          >
            <span className="flex items-center gap-1.5">
              <Archive className="h-3.5 w-3.5" /> Archivo ({journalEntries.length})
            </span>
          </button>
        </div>

        {/* CUERPO DEL CUADERNO (Hoja física con lomo y renglones) */}
