              <div className="min-w-0 flex-1">
                <div className="flex flex-wrap gap-2">
                  <Tag
                    tone={
                      state.companion?.expedition_status === "en_expedicion"
                        ? "amber"
                        : state.companion?.expedition_status === "reparacion"
                          ? "rust"
                          : "patina"
